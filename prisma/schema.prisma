generator client {
  provider = "prisma-client-js"
}

// PostgreSQL fourni par Supabase
// DATABASE_URL doit pointer vers la base PostgreSQL de ton projet Supabase.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  USER
  ADMIN
  SUPER_ADMIN
}
enum StudentStatus {
  ELEVE
  ETUDIANT
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum ContentType {
  COURSE
  EXAM
}
enum PlanCode {
  FREE
  PREMIUM
}

model User {
  id              String          @id @default(uuid())
  firstName       String
  lastName        String
  email           String          @unique
  passwordHash    String
  type            UserType        @default(USER)
  roleId          String?
  role            Role?            @relation(fields: [roleId], references: [id])
  studentStatus   StudentStatus?
  schoolId        String?
  school          School?         @relation(fields: [schoolId], references: [id])
  academicLevelId String?
  academicLevel   AcademicLevel?  @relation(fields: [academicLevelId], references: [id])
  programId       String?
  program         Program?        @relation(fields: [programId], references: [id])
  isActive        Boolean         @default(true)
  mustChangePassword Boolean      @default(false)
  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
  passwordResetRequests PasswordResetRequest[]
  favorites       Favorite[]
  analytics       AnalyticsEvent[]
  comments        Comment[]
  payments        Payment[]
  purchases       ExamPurchase[]
  quizAttempts    QuizAttempt[]
  gamification    GamificationProfile?
  badges          UserBadge[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([type, isActive])
  @@index([schoolId])
  @@index([academicLevelId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id          String   @id @default(uuid())
  userId      String
  status      String   @default("PENDING")
  requestedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, requestedAt])
  @@index([userId, status])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  schools   School[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model School {
  id        String   @id @default(uuid())
  name      String
  type      String?
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  users     User[]
  courses   Course[]
  exams     Exam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, cityId])
  @@index([name])
  @@index([cityId])
}

model AcademicLevel {
  id            String         @id @default(uuid())
  name          String         @unique
  kind          String?
  users         User[]
  courses       Course[]
  exams         Exam[]
  quizzes       Quiz[]
  programLevels ProgramLevel[]
  examConfig    ClassExamConfig?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Program {
  id            String         @id @default(uuid())
  name          String         @unique
  kind          String?
  parentId      String?
  parent        Program?       @relation("ProgramHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Program[]      @relation("ProgramHierarchy")
  users         User[]
  courses       Course[]
  exams         Exam[]
  quizzes       Quiz[]
  programLevels ProgramLevel[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  @@index([parentId])
}

model ProgramLevel {
  id              String        @id @default(uuid())
  programId       String
  academicLevelId String
  order           Int           @default(0)
  program         Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@unique([programId, academicLevelId])
  @@index([programId, order])
  @@index([academicLevelId])
}

model ClassExamConfig {
  id                String        @id @default(uuid())
  academicLevelId   String        @unique
  academicLevel     AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  exercisesEnabled  Boolean       @default(true)
  pastExamsEnabled  Boolean       @default(false)
  mockExamsEnabled  Boolean       @default(false)
  isExamClass       Boolean       @default(false)
  continuousAssessmentEnabled Boolean @default(true)
  normalSessionEnabled Boolean @default(true)
  btsDutExamEnabled Boolean @default(false)
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  courses   Course[]
  exams     Exam[]
  quizzes   Quiz[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String?
  content         String?
  status          ContentStatus @default(DRAFT)
  isPremium       Boolean       @default(false)
  premiumPrice    Decimal?      @db.Decimal(12,2)
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id])
  academicLevelId String?
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  schoolId        String?
  school          School?       @relation(fields: [schoolId], references: [id])
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id])
  sections        CourseSection[]
  favorites       Favorite[]
  analytics       AnalyticsEvent[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([subjectId, academicLevelId])
}

model CourseSection {
  id        String    @id @default(uuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int       @default(0)
  lessons   Lesson[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([courseId, order])
}

model Lesson {
  id          String        @id @default(uuid())
  sectionId   String
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  content     String?
  order       Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([sectionId, order])
}

model Exam {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String?
  year            Int?
  category        String?
  fileUrl         String?
  status          ContentStatus @default(DRAFT)
  isPremium       Boolean       @default(false)
  premiumPrice    Decimal?      @db.Decimal(12,2)
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id])
  academicLevelId String?
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  schoolId        String?
  school          School?       @relation(fields: [schoolId], references: [id])
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id])
  solution        ExamSolution?
  payments        Payment[]
  purchases       ExamPurchase[]
  favorites       Favorite[]
  analytics       AnalyticsEvent[]
  comments        Comment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([status, year])
  @@index([subjectId, academicLevelId])
  @@index([isPremium, premiumPrice])
}

model ExamSolution {
  id        String   @id @default(uuid())
  examId    String   @unique
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text      String?
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examId    String?
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, courseId, examId])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([examId, createdAt])
  @@index([userId, createdAt])
}

model Quiz {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String?
  status          ContentStatus @default(DRAFT)
  subjectId       String?
  subject         Subject?      @relation(fields: [subjectId], references: [id])
  academicLevelId String?
  academicLevel   AcademicLevel? @relation(fields: [academicLevelId], references: [id])
  programId       String?
  program         Program?      @relation(fields: [programId], references: [id])
  questions       QuizQuestion[]
  attempts        QuizAttempt[]
  timerEnabled    Boolean       @default(true)
  timerSeconds    Int           @default(1800)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([status, createdAt])
  @@index([subjectId, academicLevelId])
  @@index([programId])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  total       Int
  durationSec Int?
  answers     Json?
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@index([userId, completedAt])
  @@index([quizId, completedAt])
}

model GamificationProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  points            Int      @default(0)
  currentStreak     Int      @default(0)
  bestStreak        Int      @default(0)
  lastActivityDate  DateTime? @db.Date
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([points])
}

model GamificationLevel {
  id          String   @id @default(uuid())
  name        String
  minPoints   Int
  icon        String   @default("⭐")
  description String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([minPoints])
  @@index([active, order])
}

model Badge {
  id                String     @id @default(uuid())
  code              String     @unique
  name              String
  description       String
  icon              String     @default("🏅")
  requirementType   String
  requirementValue  Int        @default(1)
  active            Boolean    @default(true)
  users             UserBadge[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  @@index([active])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  earnedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@unique([userId, badgeId])
  @@index([userId, earnedAt])
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([quizId, order])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  examId    String?
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  query     String?
  language  String   @default("fr")
  device    String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([type, createdAt])
  @@index([query])
}

model SearchNoResult {
  id        String   @id @default(uuid())
  query     String
  language  String   @default("fr")
  userId    String?
  device    String?
  createdAt DateTime @default(now())
  @@index([query])
  @@index([createdAt])
}

enum PaymentTargetType {
  PREMIUM_PLAN
  EXAM
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  category    String   @default("GENERAL")
  type        String   @default("STRING")
  value       String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  @@index([category, enabled])
}

model PremiumSettings {
  id                  String   @id @default("main")
  enabled             Boolean  @default(true)
  premiumPrice        Decimal  @db.Decimal(12,2) @default(0)
  durationDays        Int      @default(30)
  orangeMoneyNumber   String   @default("692860695")
  orangeMoneyName     String   @default("TCHOUPE NGASSA DANIELLA")
  mtnMomoNumber       String   @default("652591205")
  mtnMomoName         String   @default("TCHOUPE NGASSA DANIELLA")
  whatsappNumber      String   @default("692860695")
  paymentInstructions String
  updatedAt           DateTime @updatedAt
}

model Plan {
  id            String      @id @default(uuid())
  code          PlanCode    @unique
  name          String
  description   String?
  active        Boolean     @default(true)
  subscriptions Subscription[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String   @default("inactive")
  provider  String?
  externalId String?
  startsAt  DateTime?
  endsAt    DateTime?
  plan      Plan     @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
}

model Payment {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal           @db.Decimal(12,2)
  currency        String            @default("XAF")
  provider        String?
  status          String            @default("pending")
  externalId      String?
  targetType      PaymentTargetType @default(PREMIUM_PLAN)
  examId          String?
  exam            Exam?             @relation(fields: [examId], references: [id], onDelete: SetNull)
  requestedAmount Decimal?          @db.Decimal(12,2)
  durationDays    Int?
  createdAt       DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  purchase       ExamPurchase?
  @@index([userId, status])
  @@index([examId, status])
}

model ExamPurchase {
  id          String   @id @default(uuid())
  userId      String
  examId      String
  paymentId   String   @unique
  purchasedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@unique([userId, examId])
  @@index([userId])
  @@index([examId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}


model SiteNotice {
  id        String             @id @default("main")
  enabled   Boolean            @default(false)
  type      SiteNoticeType     @default(INFO)
  audience  SiteNoticeAudience @default(BOTH)
  title     String             @default("Information")
  message   String
  updatedAt DateTime           @updatedAt
}

enum SiteNoticeType {
  INFO
  WARNING
  MAINTENANCE
  SUCCESS
}

enum SiteNoticeAudience {
  BEFORE_LOGIN
  AFTER_LOGIN
  BOTH
}
