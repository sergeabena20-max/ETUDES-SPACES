# Base de données PostgreSQL Supabase
DATABASE_URL=

# Authentification / sessions
AUTH_SECRET=

# Compte Super Admin initial
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé serveur Supabase (uniquement côté serveur, jamais exposée au frontend)
SUPABASE_SECRET_KEY=

# Réinitialisation du mot de passe (Resend)
# Crée une clé API sur https://resend.com/api-keys
RESEND_API_KEY=
# Exemple : Études Space <noreply@ton-domaine.cm> (domaine vérifié chez Resend)
EMAIL_FROM=
# URL publique du site, sans slash final, ex. https://etudes-spaces.vercel.app
NEXT_PUBLIC_APP_URL=
